                            <!-- Product name-->
                            <h5 class="fw-bolder">@item.Name</h5>
                            <!-- Product reviews-->
                            <div class="d-flex justify-content-center small text-warning mb-2">
                                <div class="bi-star-fill"></div>
                                <div class="bi-star-fill"></div>
                                <div class="bi-star-fill"></div>
                                <div class="bi-star-fill"></div>
                                <div class="bi-star-fill"></div>
                            </div>
                            <!-- Product price-->
                            <span class="text-muted text-decoration-line-through">@item.Price.ToString("c")</span>
                            @((item.Price - (item.Price * (item.Discount / 100))).ToString("c"))
                        </div>
                    </div>
                    <!-- Product actions-->
                    <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                        <div class="text-center"><a class="btn btn-outline-dark mt-auto" href="#">Add to cart</a></div>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>

    <div class="container">
        <div class="row" id="comments">
            <h3>Feedbacks</h3>
        </div>
    </div>
    <div class="container mt-1 d-flex justify-content-center">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <ul class="list-unstyled">
                        @foreach(var item in Model.Ratings)
                        {
                            <!--FIRST LIST ITEM-->
                            <li class="media my-3">

                                <div class="row d-flex">
                                    <div class="col-9 flex-grow-1">
                                        <span class="round pt-2"><img src="~/images/users/@item.ApplicationUser.Img" class="align-self-start mr-3"></span>
                                    </div>
                                    <div class="col-3">
                                        @if (ViewBag.isRated is not null && !ViewBag.isRated)
                                        {
                                            <a href="/customer/home/IncremntRate/@item.Id?productId=@Model.Product.Id"><i class="bi bi-arrow-up-square-fill"></i></a>
                                        }
                                        else
                                        {
                                            <a class="disabled" href="/customer/home/IncremntRate/@item.Id?productId=@Model.Product.Id"><i class="bi bi-arrow-up-square-fill"></i></a>
                                        }
                                        @if(item.Rank > 0)
                                        {
                                            <span class="text-success">@item.Rank</span>
                                        }
                                        else if (item.Rank == 0)
                                        {
                                            <span>@item.Rank</span>
                                        }
                                        else if (item.Rank < 0)
                                        {
                                            <span class="text-danger">@item.Rank</span>
                                        }

                                        @if (ViewBag.isRated is not null && !ViewBag.isRated)
                                        {
                                            <a href="/customer/home/DecremntRate/@item.Id?productId=@Model.Product.Id"><i class="bi bi-arrow-down-square-fill"></i></a>

                                        }
                                        else
                                        {
                                            <a class="disabled" href="/customer/home/DecremntRate/@item.Id?productId=@Model.Product.Id"><i class="bi bi-arrow-down-square-fill"></i></a>
                                        }

                                    </div>
                                </div>

                                <div class="media-body">
                                    <div class="row d-flex">
                                        <h6 class="user pt-2">@item.ApplicationUser.Name</h6>
                                        <div class="ml-auto">
                                            @for(var i = 0;i<item.Rate;i++)
                                            {
                                                <i class="bi bi-star-fill"></i>
                                            }
                                        </div>
                                    </div>
                                    <p class="text">@item.Comment</p>
                                    @if(item.Img is not null)
                                    {
                                        <div class="images mt-2"> <img style="width: 20%" src="~/images/ratings/@item.Img" /> </div>
                                    }
                                </div>
                            </li>

                            <div class="row m-3">
                                @foreach(var reply in Model.RatingReplys)
                                {
                                    if(item.Id == reply.RatingId)
                                    {
                                        <div class="media-body">
                                            <div class="row d-flex">
                                                <h6 class="user pt-2">Byer <i class="bi bi-check2-circle"></i></h6>
                                            </div>
                                            <p class="text">@reply.Comment</p>
                                        </div>
                                    }
                                }
                            </div>

                            @if(Model.Product.ApplicationUser.UserName == User.Identity.Name)
                            {
                                <div class="row m-3">
                                    <form method="post" action="/Customer/Home/Reply">
                                        <input type="hidden" name="id" value="@Model.Product.Id" />
                                        <input type="hidden" name="ratingId" value="@item.Id" />

                                        <div class="form-floating">
                                            <textarea name="reply" class="form-control" placeholder="Leave a comment here" id="floatingTextarea"></textarea>
                                            <label for="floatingTextarea">Reply</label>
                                        </div>

                                        <button type="submit" class="btn btn-primary my-2">Submit</button>
                                    </form>
                                </div>
                            }
                            <hr />
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>